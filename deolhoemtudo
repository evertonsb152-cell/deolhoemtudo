                changeVolume(document.getElementById("volume-slider").value);
            }
        }

        function updateLiveClockAndSchedule() {
            const now = new Date();
            const day = now.getDay();
            const hours = now.getHours();
            const minutes = now.getMinutes();
            const totalMinutes = hours * 60 + minutes;

            const clockEl = document.getElementById("live-clock");
            if (clockEl) {
                clockEl.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
            }

            const isWeekday = day >= 1 && day <= 5;
            const isProgramTime = totalMinutes >= (8 * 60 + 30) && totalMinutes <= (10 * 60);

            const badge = document.getElementById("on-air-badge");
            const dot = document.getElementById("on-air-dot");
            const label = document.getElementById("on-air-label");

            if (isWeekday && isProgramTime) {
                badge.className = "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-radioRed-600 text-white shadow";
                dot.className = "w-2 h-2 rounded-full bg-white animate-ping";
                label.textContent = "NO AR AGORA • DE OLHO EM TUDO";
            } else {
                badge.className = "inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-400/40";
                dot.className = "w-2 h-2 rounded-full bg-amber-400";
                label.textContent = "SEG A SEX • 08H30 ÀS 10H00";
            }
        }

        // ---------------------------------------------------------------------
        // 5. MODAL DE LEITURA + NARRAÇÃO PT-BR + COMENTÁRIOS DOS OUVINTES
        // ---------------------------------------------------------------------
        let isArticleAudioPlaying = false;

        function openArticleModal(id) {
            const article = articlesData.find(a => a.id === id);
            if (!article) return;

            activeModalArticle = article;
            stopArticleAudio();

            const badge = document.getElementById("modal-badge");
            badge.textContent = article.city;
            badge.className = "text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded bg-emerald-600 text-white";

            document.getElementById("modal-category").textContent = article.category;
            document.getElementById("modal-title").textContent = article.title;
            document.getElementById("modal-author").textContent = article.author;
            document.getElementById("modal-date").textContent = article.date;
            document.getElementById("modal-read-time").textContent = article.readTime;
            document.getElementById("modal-image").src = article.image;
            document.getElementById("modal-caption").textContent = article.caption;

            document.getElementById("modal-body").innerHTML = article.content.map(p => `<p>${escapeHTML(p)}</p>`).join("");
            renderArticleComments();

            const modal = document.getElementById("article-modal");
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            document.body.style.overflow = "hidden";
        }

        function closeArticleModal() {
            stopArticleAudio();
            const modal = document.getElementById("article-modal");
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            document.body.style.overflow = "";
        }

        function toggleArticleAudio() {
            if (!activeModalArticle) return;

            if (isArticleAudioPlaying) {
                stopArticleAudio();
            } else {
                if (isRadioPlaying) toggleRadioStream();
                isArticleAudioPlaying = true;
                document.getElementById("article-tts-icon").className = "fa-solid fa-stop";
                document.getElementById("article-tts-status").textContent = "Narrando notícia em voz alta (Boletim FM 87,9)...";

                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    const fullText = `De Olho em Tudo, FM Pantaneira 87,9. Notícia de ${activeModalArticle.city}. ${activeModalArticle.title}. ${activeModalArticle.content.join(" ")}`;
                    const utter = new SpeechSynthesisUtterance(fullText);
                    utter.lang = "pt-BR";
                    utter.rate = 1.05;
                    utter.onend = () => stopArticleAudio();
                    window.speechSynthesis.speak(utter);
                } else {
                    showToast("Reproduzindo boletim informativo...");
                }
            }
        }

        function stopArticleAudio() {
            isArticleAudioPlaying = false;
            if ('speechSynthesis' in window) window.speechSynthesis.cancel();
            const icon = document.getElementById("article-tts-icon");
            const status = document.getElementById("article-tts-status");
            if (icon) icon.className = "fa-solid fa-volume-high";
            if (status) status.textContent = "Clique no ícone para ouvir a leitura em voz alta";
        }

        function renderArticleComments() {
            if (!activeModalArticle) return;
            const list = document.getElementById("article-comments-list");
            if (!activeModalArticle.comments || activeModalArticle.comments.length === 0) {
                list.innerHTML = `<p class="text-xs text-slate-400 italic">Seja o primeiro ouvinte a comentar esta reportagem!</p>`;
                return;
            }
            list.innerHTML = activeModalArticle.comments.map(c => `
                <div class="bg-white p-3 rounded-xl border border-slate-200/80">
                    <div class="text-[11px] font-bold text-navy-900 mb-0.5">${escapeHTML(c.author)}</div>
                    <p class="text-xs text-slate-600">${escapeHTML(c.text)}</p>
                </div>
            `).join("");
        }

        function addArticleComment(e) {
            e.preventDefault();
            if (!activeModalArticle) return;
            const authorInput = document.getElementById("comment-author");
            const textInput = document.getElementById("comment-text");
            const author = authorInput.value.trim();
            const text = textInput.value.trim();
            if (!author || !text) return;

            activeModalArticle.comments.unshift({ author, text });
            saveArticlesToStorage();
            authorInput.value = "";
            textInput.value = "";
            renderArticleComments();
            showToast("Seu comentário foi publicado no mural da notícia!");
        }

        function shareWhatsApp() {
            if (!activeModalArticle) return;
            const text = encodeURIComponent(`*De Olho em Tudo • Adilson Malaquias (FM Pantaneira 87,9)*\n[${activeModalArticle.city}] ${activeModalArticle.title}\nOuça de seg a sex, das 08h30 às 10h00 em fmpantaneira.com.br`);
            window.open(`https://wa.me/?text=${text}`, "_blank");
        }

        function copyArticleLink() {
            if (!activeModalArticle) return;
            const url = `${window.location.origin}${window.location.pathname}#noticia-${activeModalArticle.id}`;
            const tempInput = document.createElement("input");
            tempInput.value = url;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            showToast("Link da reportagem copiado!");
        }

        // ---------------------------------------------------------------------
        // 6. FORMULÁRIO ALÔ OUVINTE / DENÚNCIA (WHATSAPP OU E-MAIL OFICIAL)
        // ---------------------------------------------------------------------
        function setSubmitChannel(channel) {
            selectedSubmitChannel = channel;
        }

        function sendListenerDirect(e) {
            e.preventDefault();
            const name = document.getElementById("ql-name").value.trim();
            const message = document.getElementById("ql-message").value.trim();
            if (!name || !message) return;

            if (selectedSubmitChannel === "whatsapp") {
                const wpText = encodeURIComponent(
                    `*Alô Ouvinte • Programa De Olho em Tudo (FM 87,9)*\n*Ouvinte:* ${name}\n*Mensagem/Denúncia:* ${message}`
                );
                window.open(`https://wa.me/5567996241272?text=${wpText}`, "_blank");
                showToast("Abrindo WhatsApp do programa (67) 99624-1272...");
            } else {
                const subject = encodeURIComponent(`Alô Ouvinte / Pauta - ${name}`);
                const body = encodeURIComponent(`Olá Adilson Malaquias,\n\nNome/Cidade: ${name}\nMensagem para o programa De Olho em Tudo (FM Pantaneira 87,9):\n\n${message}`);
                window.location.href = `mailto:Omalaquiassouza@gmail.com?subject=${subject}&body=${body}`;
                showToast("Abrindo seu e-mail para Omalaquiassouza@gmail.com...");
            }

            document.getElementById("quick-listener-form").reset();
        }

        // ---------------------------------------------------------------------
        // 7. ENQUETE DO OUVINTE
        // ---------------------------------------------------------------------
        const pollData = [
            { id: 1, label: "Segurança e obras de duplicação na rodovia BR-163", votes: 412 },
            { id: 2, label: "Infraestrutura e saúde nos bairros de Coxim e Região Norte", votes: 298 },
            { id: 3, label: "Incentivos e cotações da agropecuária em MS", votes: 184 },
            { id: 4, label: "Preservação do Rio Taquari e turismo regional", votes: 115 }
        ];
        let hasVotedPoll = false;
        let selectedPollId = null;

        function renderPoll() {
            const container = document.getElementById("poll-options");
            const totalVotes = pollData.reduce((acc, item) => acc + item.votes, 0);
            document.getElementById("poll-total-votes").textContent = `${totalVotes.toLocaleString('pt-BR')} votos`;

            container.innerHTML = pollData.map(opt => {
                const pct = Math.round((opt.votes / totalVotes) * 100);
                const isSelected = selectedPollId === opt.id;

                if (!hasVotedPoll) {
                    return `
                        <button onclick="votePoll(${opt.id})" class="w-full text-left p-3 rounded-xl border border-slate-200 hover:border-navy-900 hover:bg-slate-50 transition flex items-center justify-between gap-2 group">
                            <span class="text-xs font-semibold text-slate-700 group-hover:text-navy-900">${opt.label}</span>
                            <span class="w-4 h-4 rounded-full border-2 border-slate-300 group-hover:border-radioRed-600 shrink-0"></span>
                        </button>
                    `;
                } else {
                    return `
                        <div class="p-3 rounded-xl border ${isSelected ? 'border-radioRed-500 bg-red-50/30' : 'border-slate-200 bg-slate-50'}">
                            <div class="flex justify-between text-xs font-bold mb-1.5 gap-2">
                                <span class="${isSelected ? 'text-radioRed-700' : 'text-navy-900'}">
                                    ${opt.label} ${isSelected ? '(Seu voto)' : ''}
                                </span>
                                <span class="text-navy-900 shrink-0">${pct}%</span>
                            </div>
                            <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                                <div class="${isSelected ? 'bg-radioRed-600' : 'bg-navy-900'} h-full rounded-full transition-all duration-700" style="width: ${pct}%"></div>
                            </div>
                        </div>
                    `;
                }
            }).join("");
        }

        function votePoll(id) {
            if (hasVotedPoll) return;
            const option = pollData.find(o => o.id === id);
            if (option) {
                option.votes += 1;
                hasVotedPoll = true;
                selectedPollId = id;
                renderPoll();
                document.getElementById("poll-feedback").classList.remove("hidden");
                showToast("Voto registrado! Sintonize na FM Pantaneira 87,9 às 08h30.");
            }
        }

        // ---------------------------------------------------------------------
        // 8. UTILITÁRIOS E INICIALIZAÇÃO GLOBAL
        // ---------------------------------------------------------------------
        function escapeHTML(str) {
            return String(str).replace(/[&<>'"]/g, tag => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            }[tag]));
        }

        let toastTimeout = null;
        function showToast(msg) {
            const toast = document.getElementById("toast");
            document.getElementById("toast-message").textContent = msg;
            toast.classList.remove("hidden");
            toast.classList.add("flex");
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add("hidden");
                toast.classList.remove("flex");
            }, 3800);
        }

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closeArticleModal();
                closeEditorModal();
            }
        });

        document.getElementById("article-modal").addEventListener("click", (e) => {
            if (e.target.id === "article-modal") closeArticleModal();
        });

        document.getElementById("editor-modal").addEventListener("click", (e) => {
            if (e.target.id === "editor-modal") closeEditorModal();
        });

        // Exposição explícita no escopo global window
        window.filterByCity = filterByCity;
        window.filterByCategory = filterByCategory;
        window.handleSearch = handleSearch;
        window.clearSearch = clearSearch;
        window.resetFilters = resetFilters;
        window.openEditorModal = openEditorModal;
        window.closeEditorModal = closeEditorModal;
        window.saveArticleFromEditor = saveArticleFromEditor;
        window.deleteArticle = deleteArticle;
        window.resetDefaultArticles = resetDefaultArticles;
        window.editCurrentModalArticle = editCurrentModalArticle;
        window.toggleRadioStream = toggleRadioStream;
        window.changeVolume = changeVolume;
        window.toggleMute = toggleMute;
        window.openArticleModal = openArticleModal;
        window.closeArticleModal = closeArticleModal;
        window.toggleArticleAudio = toggleArticleAudio;
        window.addArticleComment = addArticleComment;
        window.shareWhatsApp = shareWhatsApp;
        window.copyArticleLink = copyArticleLink;
        window.setSubmitChannel = setSubmitChannel;
        window.sendListenerDirect = sendListenerDirect;
        window.votePoll = votePoll;

        // Inicialização imediata e segura
        renderNews();
        renderPoll();
        updateLiveClockAndSchedule();
        setInterval(updateLiveClockAndSchedule, 15000);
    </script>
</body>
</html>
