            } else {
                icon.className = "fa-solid fa-volume-high text-xs";
            }
            if (masterGain) {
                masterGain.gain.value = isMuted ? 0 : currentVolume * 0.14;
            }
        }

        function toggleMute() {
            isMuted = !isMuted;
            const icon = document.getElementById("volume-icon");
            if (isMuted) {
